# Ambiente acadêmico/demonstrativo. Não use dados clínicos reais.
# Em produção no Netlify, configure os segredos em:
# Project configuration > Environment variables, com escopo para Functions.

NOUS_SESSION_SECRET=change-this-session-secret
NOUS_DATA_SECRET=change-this-data-encryption-secret

NOUS_PATIENT_EMAIL=paciente@demo.nous
NOUS_PATIENT_PASSWORD=NousPaciente2026!
NOUS_PSYCHOLOGIST_EMAIL=psicologo@demo.nous
NOUS_PSYCHOLOGIST_PASSWORD=NousPsicologo2026!

# URL pública usada nos metadados. Ex.: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional. Localmente o padrão é .data/. Em runtime serverless o projeto
# escolhe automaticamente um diretório temporário gravável.
# NOUS_DATA_DIR=/caminho/gravavel
